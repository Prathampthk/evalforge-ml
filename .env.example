# ────────────────────────────────────────────────────────────────────────────
# LLM Configuration (OpenAI or compatible)
# ────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-your-api-key

# Leave unset for OpenAI; set for an OpenAI-compatible provider.
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=gpt-4o-mini

# ────────────────────────────────────────────────────────────────────────────
# Embeddings Configuration
# ────────────────────────────────────────────────────────────────────────────
# Set EmbeddingConfig in Python; these are not environment-backed settings.
# Default: BAAI/bge-large-en-v1.5, dimension 1024, device cpu.

# ────────────────────────────────────────────────────────────────────────────
# Vector Store Configuration
# ────────────────────────────────────────────────────────────────────────────
# Set VectorStoreConfig in Python; these are not environment-backed settings.
# Default: flat index, ./vector_store_data persistence directory.

# ────────────────────────────────────────────────────────────────────────────
# FastAPI Service Configuration
# ────────────────────────────────────────────────────────────────────────────
RAG_API_TOKEN=your-secret-bearer-token-here
RAG_AUTH_DISABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# ────────────────────────────────────────────────────────────────────────────
# Telemetry & Observability
# ────────────────────────────────────────────────────────────────────────────
TELEMETRY_ENABLED=true
TELEMETRY_EXPORTER=console
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_SERVICE_NAME=evalforge
SERVICE_VERSION=0.1.0
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-secure-grafana-password

# ────────────────────────────────────────────────────────────────────────────
# Python Runtime Configuration
# ────────────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
